YOUTH_POLICY_API_KEY=
ANTHROPIC_API_KEY=
EXTERNAL_AI_ENABLED=false
AGENT_DAILY_LIMIT=200
# 실제 사용자 정보 요약을 계획 에이전트(AI)로 보낼지. 운영사무국 허용 확인 전까지 false
PLAN_AI_FOR_USERS=false
# AI 제공자: anthropic(기본) 또는 gemini
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 검증 1건 시간 한도(밀리초). 기본 60000
VERIFY_DEADLINE_MS=
# 계정·계획·알림 저장 SQLite 경로. 비우면 로컬 data/db/accounts.sqlite, Vercel /tmp(재시작 시 사라짐)
ACCOUNT_DB_PATH=
# 알림 정기 작업(/api/cron/notifications) 인증. 비우면 정기 작업 비활성
CRON_SECRET=
