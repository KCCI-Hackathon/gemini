# 이 파일을 .env.local 로 복사하고, 비어 있는 키 값만 채운다. .env.local 은 커밋하지 않는다.

# ── 외부 AI 전체 스위치 ── false 면 AI 없이 판정 · 규칙 추천만
EXTERNAL_AI_ENABLED=true

# ── 상담 · 추천 에이전트 (메인 화면 길잡이, /api/plan version 2) : OpenAI ──
PLAN_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# "추천해줘" 에만 쓸 모델. 비우면 OPENAI_MODEL
OPENAI_RECOMMEND_MODEL=
# 실제 사용자 정보 요약 · 자유 질문을 AI 로 보낼지. 운영사무국 허용 확인 전까지 false (false 면 시연 인물만 AI 사용)
PLAN_AI_FOR_USERS=false
# 유해 글 검사. 둘 다 있어야 동작
MODERATION_ENABLED=false
MODERATION_MODEL=

# ── 공고 대조 검증 에이전트 (/api/verify) · 옛 화면 에이전트 : Gemini ──
# AI 제공자: gemini 또는 anthropic(비우면 anthropic)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
# 검증 에이전트 공급자(임시: Gemini 한도 때문에 시연용 GPT). 비우면 PLAN_AI_PROVIDER=openai 일 때 openai, 아니면 AI_PROVIDER
VERIFY_AI_PROVIDER=
# 검증 에이전트 OpenAI 모델. 비우면 OPENAI_MODEL
OPENAI_VERIFY_MODEL=
# 검증 1건 시간 한도(밀리초). 기본 60000
VERIFY_DEADLINE_MS=

# ── 데이터 갱신 스크립트 (온통청년 스냅샷 받기) ──
YOUTH_POLICY_API_KEY=

# ── 계정 · 계획 · 알림 저장 ──
# SQLite 경로. 비우면 로컬 data/db/accounts.sqlite, Vercel /tmp(재시작 시 사라짐)
ACCOUNT_DB_PATH=
# 알림 정기 작업(/api/account/cron/notifications) 인증. 비우면 정기 작업 비활성
CRON_SECRET=
